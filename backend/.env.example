# Copy this file to backend/.env (git-ignored) and change the password.
# docker-compose.yml and the app (app/config.py) both read backend/.env.

# Database container
POSTGRES_USER=dumriya
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dumriya
POSTGRES_PORT=5432

# App settings. DATABASE_URL must match the values above:
# postgresql+psycopg://<user>:<password>@localhost:<port>/<db>
DATABASE_URL=postgresql+psycopg://dumriya:change-me@localhost:5432/dumriya
APP_VERSION=0.1.0
