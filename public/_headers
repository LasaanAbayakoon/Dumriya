# Response headers for Cloudflare Pages (also served by `npm run preview`, so every Playwright
# test runs under this policy; see build/headers.ts). One header per line, indented.
# Referrer-Policy: the map tile server's usage policy asks for a Referer; only our origin is sent.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self' https://tile.openstreetmap.org; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
  X-Robots-Tag: noindex

# Vite puts a content hash in every file name under /assets, so these never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
